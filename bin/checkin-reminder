#!/bin/bash
#
# checkin-reminder — ti ricorda di fare il check-in quando sei in ufficio.
# Rileva l'ufficio dalla rete Wi-Fi (es. reply-N) e, opzionalmente, dal dominio DNS.
# Tutto gira in locale: nessun dato viene inviato all'esterno.
#
# Uso: checkin-reminder [check|status|test|done|reset|config|log|uninstall|version|help]

set -u

VERSION="1.0.0"
APP_ID="com.reply.checkin-reminder"
CONFIG_DIR="$HOME/.config/checkin-reminder"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="$HOME/Library/Application Support/checkin-reminder"
LOG_FILE="$HOME/Library/Logs/checkin-reminder.log"
PLIST="$HOME/Library/LaunchAgents/$APP_ID.plist"

# ---- Valori di default (sovrascrivibili nel file di config) ----
SSID_PATTERN='^reply-'          # regex (case-insensitive) sul nome della Wi-Fi
DNS_DOMAIN_PATTERN=''           # regex sul dominio DNS, es. 'reply\.it$' (vuoto = disattivato)
WORKDAYS='1 2 3 4 5'            # 1=lunedì ... 7=domenica
START_HOUR=7                    # promemoria solo da quest'ora...
END_HOUR=20                     # ...fino a quest'ora (esclusa)
CHECKIN_URL='https://deskbooking.reply.com/home'  # vuoto = niente pulsante "Apri check-in"
SNOOZE_MINUTES=15               # "ricordamelo più tardi"
REMIND_STYLE='dialog'           # dialog | notification
TITLE='Check-in'
MESSAGE='Sei in ufficio: ricordati di fare il check-in su Desk Booking ("Where are you today?")!'
SSID_SLOW_FALLBACK=1            # usa system_profiler se gli altri metodi falliscono

# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"

# ---------------------------------------------------------------- utilità
log()   { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }
today() { date +%Y-%m-%d; }
now()   { date +%s; }

# ---------------------------------------------------------------- rete
wifi_iface() {
  local i
  i="$(networksetup -listallhardwareports 2>/dev/null \
      | awk '/^Hardware Port: (Wi-Fi|AirPort)/{getline; print $2; exit}')"
  echo "${i:-en0}"
}

valid_ssid() { [ -n "${1:-}" ] && [ "$1" != "<redacted>" ]; }

ssid_from_ipconfig() {
  ipconfig getsummary "$1" 2>/dev/null \
    | awk '/^ *SSID : /{sub(/^ *SSID : /,""); print; exit}'
}

ssid_from_networksetup() {
  networksetup -getairportnetwork "$1" 2>/dev/null \
    | sed -n 's/^Current Wi-Fi Network: //p'
}

ssid_from_profiler() {
  system_profiler SPAirPortDataType 2>/dev/null \
    | awk '/Current Network Information:/{getline; sub(/^[ \t]+/,""); sub(/:$/,""); print; exit}'
}

current_ssid() {
  local ifc s
  ifc="$(wifi_iface)"
  s="$(ssid_from_ipconfig "$ifc")";      valid_ssid "$s" && { echo "$s"; return; }
  s="$(ssid_from_networksetup "$ifc")";  valid_ssid "$s" && { echo "$s"; return; }
  if [ "$SSID_SLOW_FALLBACK" = 1 ]; then
    s="$(ssid_from_profiler)";           valid_ssid "$s" && { echo "$s"; return; }
  fi
}

dns_domains() {
  scutil --dns 2>/dev/null \
    | awk '/^ *(search domain\[[0-9]+\]|domain) *:/{sub(/^[^:]*: */,""); print}' \
    | sort -u
}

OFFICE_REASON=''
at_office() {
  local s d
  if [ -n "$SSID_PATTERN" ]; then
    s="$(current_ssid)"
    if [ -n "$s" ] && printf '%s' "$s" | grep -Eiq -- "$SSID_PATTERN"; then
      OFFICE_REASON="Wi-Fi: $s"; return 0
    fi
  fi
  if [ -n "$DNS_DOMAIN_PATTERN" ]; then
    d="$(dns_domains | grep -Ei -- "$DNS_DOMAIN_PATTERN" | head -1)"
    if [ -n "$d" ]; then OFFICE_REASON="rete: $d"; return 0; fi
  fi
  return 1
}

in_window() {
  local dow h
  dow="$(date +%u)"
  h="$(date +%H)"; h=$((10#$h))
  case " $WORKDAYS " in *" $dow "*) ;; *) return 1 ;; esac
  [ "$h" -ge "$START_HOUR" ] && [ "$h" -lt "$END_HOUR" ]
}

# ---------------------------------------------------------------- stato
done_file()  { echo "$STATE_DIR/done-$(today)"; }
is_done()    { [ -f "$(done_file)" ]; }
mark_done()  {
  rm -f "$STATE_DIR"/done-* "$STATE_DIR/snooze_until"
  : > "$(done_file)"
  log "check-in segnato come fatto"
}
snooze()     { echo $(( $(now) + ${1:-$SNOOZE_MINUTES} * 60 )) > "$STATE_DIR/snooze_until"; }
is_snoozed() {
  local u
  [ -f "$STATE_DIR/snooze_until" ] || return 1
  u="$(cat "$STATE_DIR/snooze_until" 2>/dev/null)"
  [ "$(now)" -lt "${u:-0}" ]
}

acquire_lock() {
  local l="$STATE_DIR/lock" m
  mkdir "$l" 2>/dev/null && return 0
  m="$(stat -f %m "$l" 2>/dev/null || echo 0)"
  if [ $(( $(now) - m )) -gt 1800 ]; then          # lock orfano (>30 min)
    rmdir "$l" 2>/dev/null; mkdir "$l" 2>/dev/null && return 0
  fi
  return 1
}
release_lock() { rmdir "$STATE_DIR/lock" 2>/dev/null; }

# ---------------------------------------------------------------- promemoria
remind() {
  local reason="$1" answer

  if [ "$REMIND_STYLE" = notification ]; then
    osascript - "$TITLE" "$MESSAGE" "$reason" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) subtitle (item 3 of argv) sound name "Glass"
end run
APPLESCRIPT
    mark_done   # la notifica non ha pulsanti: una sola al giorno
    return
  fi

  answer="$(osascript - "$TITLE" "$MESSAGE" "$reason" "$CHECKIN_URL" "$SNOOZE_MINUTES" 2>/dev/null <<'APPLESCRIPT'
on run argv
  set theTitle to item 1 of argv
  set theMsg to item 2 of argv
  set theReason to item 3 of argv
  set theUrl to item 4 of argv
  set snoozeLabel to "Tra " & (item 5 of argv) & " min"
  if theUrl is "" then
    set btns to {snoozeLabel, "Fatto"}
    set defBtn to "Fatto"
  else
    set btns to {snoozeLabel, "Fatto", "Apri check-in"}
    set defBtn to "Apri check-in"
  end if
  activate
  try
    set res to display dialog (theMsg & return & return & "(" & theReason & ")") with title theTitle buttons btns default button defBtn with icon note giving up after 600
    if gave up of res then return "timeout"
    return button returned of res
  on error
    return "cancel"
  end try
end run
APPLESCRIPT
)"

  case "$answer" in
    "Fatto")         mark_done ;;
    "Apri check-in") open "$CHECKIN_URL"; mark_done ;;
    *)               snooze "$SNOOZE_MINUTES"; log "rimandato di $SNOOZE_MINUTES min ($answer)" ;;
  esac
}

# ---------------------------------------------------------------- comandi
cmd_check() {
  in_window  || return 0
  is_done    && return 0
  is_snoozed && return 0
  at_office  || return 0
  acquire_lock || return 0
  trap release_lock EXIT
  log "in ufficio ($OFFICE_REASON): mostro il promemoria"
  remind "$OFFICE_REASON"
}

cmd_test() {
  acquire_lock || { echo "Un promemoria è già aperto."; return 1; }
  trap release_lock EXIT
  at_office || OFFICE_REASON="test"
  remind "$OFFICE_REASON"
}

yn() { if "$@"; then echo "sì"; else echo "no"; fi; }

cmd_status() {
  local ifc a b c ssid
  ifc="$(wifi_iface)"
  a="$(ssid_from_ipconfig "$ifc")"
  b="$(ssid_from_networksetup "$ifc")"
  c="$(ssid_from_profiler)"
  ssid="$(current_ssid)"

  echo "checkin-reminder $VERSION"
  echo
  echo "Config:            $CONFIG_FILE $([ -f "$CONFIG_FILE" ] && echo '' || echo '(non trovato, uso i default)')"
  echo "Pattern Wi-Fi:     ${SSID_PATTERN:-<disattivato>}"
  echo "Pattern DNS:       ${DNS_DOMAIN_PATTERN:-<disattivato>}"
  echo "URL check-in:      ${CHECKIN_URL:-<non impostato>}"
  echo
  echo "Interfaccia Wi-Fi: $ifc"
  echo "  ipconfig:        ${a:-—}"
  echo "  networksetup:    ${b:-—}"
  echo "  system_profiler: ${c:-—}"
  echo "SSID usato:        ${ssid:-<nessuno / non leggibile>}"
  echo "Domini DNS:        $(dns_domains | tr '\n' ' ')"
  echo
  echo "In ufficio adesso: $(yn at_office) ${OFFICE_REASON:+($OFFICE_REASON)}"
  echo "Orario lavorativo: $(yn in_window)"
  echo "Check-in fatto:    $(yn is_done)"
  echo "Rimandato:         $(yn is_snoozed)"
  if launchctl print "gui/$(id -u)/$APP_ID" >/dev/null 2>&1; then
    echo "Servizio:          attivo"
  else
    echo "Servizio:          NON attivo (rilancia l'installer)"
  fi

  if [ "$a" = "<redacted>" ] && ! valid_ssid "$ssid"; then
    echo
    echo "⚠️  macOS sta nascondendo il nome della Wi-Fi. Per sbloccarlo (una tantum):"
    echo "    sudo ipconfig setverbose 1"
    echo "   oppure usa DNS_DOMAIN_PATTERN nella config."
  fi
}

cmd_uninstall() {
  local self
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  launchctl bootout "gui/$(id -u)/$APP_ID" 2>/dev/null \
    || launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  rm -rf "$STATE_DIR"
  rm -f "$LOG_FILE"
  if [ "${1:-}" = "--purge" ]; then rm -rf "$CONFIG_DIR"; fi
  rm -f "$self"
  echo "checkin-reminder disinstallato.${1:+ Configurazione rimossa.}"
  [ "${1:-}" = "--purge" ] || echo "(La config resta in $CONFIG_DIR — usa 'uninstall --purge' per rimuoverla.)"
}

cmd_help() {
  cat <<EOF
checkin-reminder $VERSION — promemoria check-in quando sei in ufficio

Comandi:
  status          mostra cosa rileva (Wi-Fi, DNS, orario, stato) — utile per diagnosi
  test            mostra subito il promemoria
  done            segna il check-in di oggi come fatto
  reset           azzera lo stato di oggi (fatto / rimandato)
  config          apre il file di configurazione
  log             mostra le ultime righe del log
  uninstall       disinstalla (aggiungi --purge per rimuovere anche la config)
  version         versione
  check           (usato dal servizio) controlla e, se serve, mostra il promemoria
EOF
}

case "${1:-check}" in
  check)            cmd_check ;;
  status|doctor)    cmd_status ;;
  test)             cmd_test ;;
  done)             mark_done; echo "Ok, check-in di oggi segnato come fatto." ;;
  reset)            rm -f "$STATE_DIR"/done-* "$STATE_DIR/snooze_until"; echo "Stato di oggi azzerato." ;;
  config)           mkdir -p "$CONFIG_DIR"; [ -f "$CONFIG_FILE" ] || : > "$CONFIG_FILE"; open -t "$CONFIG_FILE" ;;
  log)              tail -n 30 "$LOG_FILE" 2>/dev/null || echo "Log vuoto." ;;
  uninstall)        cmd_uninstall "${2:-}" ;;
  version|-v|--version) echo "$VERSION" ;;
  help|-h|--help)   cmd_help ;;
  *)                cmd_help; exit 1 ;;
esac
