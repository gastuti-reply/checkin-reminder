#!/bin/bash
#
# checkin-reminder — ti ricorda di fare il check-in quando sei in ufficio.
# Rileva l'ufficio dalla rete Reply (Wi-Fi reply-N, dominio DNS) e dalla posizione del Mac.
# Tutto gira in locale: la posizione non lascia il Mac; l'unica chiamata esterna è il
# controllo aggiornamenti verso il repo.
#
# Uso: checkin-reminder [check|status|where|test|done|snooze|reset|config|log|update|uninstall|version|help]

set -u

VERSION="1.3.0"
APP_ID="com.reply.checkin-reminder"
BIN="$HOME/.local/bin/checkin-reminder"
CONFIG_DIR="$HOME/.config/checkin-reminder"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="$HOME/Library/Application Support/checkin-reminder"
LOG_FILE="$HOME/Library/Logs/checkin-reminder.log"
PLIST="$HOME/Library/LaunchAgents/$APP_ID.plist"
NOTIFIER_APP="$HOME/Applications/CheckinNotifier.app"
SHARE_DIR="$HOME/.local/share/checkin-reminder"
OFFICES_FILE="$SHARE_DIR/offices.tsv"          # elenco uffici Reply (aggiornato con le release)
USER_OFFICES_FILE="$CONFIG_DIR/offices.tsv"    # uffici aggiuntivi tuoi, stesso formato

# ---- Valori di default (sovrascrivibili nel file di config) ----
SSID_PATTERN='^reply-'                  # regex (case-insensitive) sul nome della Wi-Fi
DNS_DOMAIN_PATTERN='replynet\.prv$'     # regex sul dominio DNS della rete aziendale (vuoto = off)
VPN_COUNTS_AS_OFFICE=0                  # 0 = la rete Reply via VPN NON vale come "in ufficio"
WORKDAYS='1 2 3 4 5'                    # 1=lunedì ... 7=domenica
START_HOUR=7                            # promemoria solo da quest'ora...
END_HOUR=20                             # ...fino a quest'ora (esclusa)
LOCATION_CHECK=1                        # 1 = usa anche la posizione del Mac (serve il permesso)
OFFICE_RADIUS=250                       # metri dall'ufficio entro cui sei "in ufficio"
LOCATION_CACHE_MINUTES=10               # ogni quanto rileggere la posizione
CHECKIN_URL='https://deskbooking.reply.com/home'  # vuoto = niente pulsante "Lo faccio ora"
SNOOZE_MINUTES=15                       # "ricordamelo più tardi"
REMIND_STYLE='banner'                   # banner = notifica in alto a destra con azioni | dialog = finestra al centro
TITLE=''                                # vuoti = testi a rotazione (vedi pick_copy)
MESSAGE=''
SSID_SLOW_FALLBACK=1                    # usa system_profiler se gli altri metodi falliscono
AUTO_UPDATE=1                           # 1 = si aggiorna da solo; 0 = solo con "checkin-reminder update"
UPDATE_CHECK_HOURS=24                   # ogni quanto controllare
REPO_RAW=''                             # sorgente aggiornamenti (scritta dall'installer)

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"
[ -f "$STATE_DIR/source" ] && REPO_RAW="$(cat "$STATE_DIR/source")"

# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
[ "$REMIND_STYLE" = notification ] && REMIND_STYLE=banner   # compatibilità 1.0/1.1

# ---------------------------------------------------------------- utilità
log()   { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }
today() { date +%Y-%m-%d; }
now()   { date +%s; }

# ---------------------------------------------------------------- rete: Wi-Fi
wifi_iface() {
  local i
  i="$(networksetup -listallhardwareports 2>/dev/null \
      | awk '/^Hardware Port: (Wi-Fi|AirPort)/{getline; print $2; exit}')"
  echo "${i:-en0}"
}

valid_ssid() { [ -n "${1:-}" ] && [ "$1" != "<redacted>" ]; }

ssid_from_ipconfig() {
  ipconfig getsummary "$1" 2>/dev/null \
    | awk '/^ *SSID : /{sub(/^ *SSID : /,""); print; exit}'
}

ssid_from_networksetup() {
  networksetup -getairportnetwork "$1" 2>/dev/null \
    | sed -n 's/^Current Wi-Fi Network: //p'
}

ssid_from_profiler() {
  system_profiler SPAirPortDataType 2>/dev/null \
    | awk '/Current Network Information:/{getline; sub(/^[ \t]+/,""); sub(/:$/,""); print; exit}'
}

current_ssid() {
  local ifc s
  ifc="$(wifi_iface)"
  s="$(ssid_from_ipconfig "$ifc")";      valid_ssid "$s" && { echo "$s"; return; }
  s="$(ssid_from_networksetup "$ifc")";  valid_ssid "$s" && { echo "$s"; return; }
  if [ "$SSID_SLOW_FALLBACK" = 1 ]; then
    s="$(ssid_from_profiler)";           valid_ssid "$s" && { echo "$s"; return; }
  fi
}

# ---------------------------------------------------------------- rete: DNS
is_tunnel() { case "${1:-}" in utun*|ipsec*|ppp*|gpd*|tun*|tap*) return 0 ;; esac; return 1; }

default_iface() { route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}'; }

# Una riga per dominio: "<dominio> <interfaccia|->"
dns_domains() {
  scutil --dns 2>/dev/null | awk '
    /^resolver #/ { flush(); n=0; ifc="-"; next }
    /^DNS configuration \(for scoped/ { flush(); exit }
    /^ *(search domain\[[0-9]+\]|domain) *:/ { sub(/^[^:]*: */,""); d[++n]=$0; next }
    /^ *if_index *:/ { if (match($0, /\(([^)]+)\)/)) ifc=substr($0, RSTART+1, RLENGTH-2); next }
    function flush(  i) { for (i=1;i<=n;i++) print d[i], ifc; n=0 }
    END { flush() }
  ' | sort -u
}

# ---------------------------------------------------------------- posizione
LOCATION_FILE="$STATE_DIR/location"
LOC_STATUS='' LOC_OFFICE='' LOC_DIST='' LOC_ACC=''

file_age() { echo $(( $(now) - $(stat -f %m "$1" 2>/dev/null || echo 0) )); }

location_available() {
  [ "$LOCATION_CHECK" = 1 ] && [ -x "$NOTIFIER_APP/Contents/MacOS/CheckinNotifier" ]
}

# Chiede la posizione all'app (max ~20 s) e aggiorna $LOCATION_FILE. $1=force per ignorare la cache.
refresh_location() {
  location_available || return 1
  if [ "${1:-}" != force ] && [ -f "$LOCATION_FILE" ]; then
    local age max=$(( LOCATION_CACHE_MINUTES * 60 ))
    age="$(file_age "$LOCATION_FILE")"
    # permesso negato o localizzazione spenta: non insistere, riprova ogni 6 ore
    grep -qE '^(DENIED|DISABLED)' "$LOCATION_FILE" && max=21600
    [ "$age" -lt "$max" ] && return 0
  fi
  local offices="$OFFICES_FILE"
  [ -f "$USER_OFFICES_FILE" ] && offices="$offices,$USER_OFFICES_FILE"
  open -W -n -g -a "$NOTIFIER_APP" --args locate \
    --offices "$offices" --cache "$STATE_DIR/geocache.tsv" \
    --out "$LOCATION_FILE" --radius "$OFFICE_RADIUS" >/dev/null 2>&1
  [ -f "$LOCATION_FILE" ]
}

read_location() {
  LOC_STATUS='' LOC_OFFICE='' LOC_DIST='' LOC_ACC=''
  [ -f "$LOCATION_FILE" ] || return 1
  local ts
  IFS=$'\t' read -r LOC_STATUS LOC_OFFICE LOC_DIST LOC_ACC ts < "$LOCATION_FILE" || true
  [ -n "$LOC_STATUS" ]
}

# 0 se la posizione dice "sei in un ufficio Reply"
at_office_by_location() {
  refresh_location "${1:-}" || return 1
  read_location && [ "$LOC_STATUS" = IN ]
}

OFFICE_REASON=''
at_office() {
  local s line dom ifc primary
  OFFICE_REASON=''
  if [ -n "$SSID_PATTERN" ]; then
    s="$(current_ssid)"
    if [ -n "$s" ] && printf '%s' "$s" | grep -Eiq -- "$SSID_PATTERN"; then
      OFFICE_REASON="📶 Wi-Fi $s"; name_office_from_cache; return 0
    fi
  fi
  if [ -n "$DNS_DOMAIN_PATTERN" ]; then
    primary="$(default_iface)"
    while read -r dom ifc; do
      printf '%s' "$dom" | grep -Eiq -- "$DNS_DOMAIN_PATTERN" || continue
      if [ "$VPN_COUNTS_AS_OFFICE" != 1 ]; then
        # resolver legato a un tunnel, oppure tutto il traffico passa dal tunnel → VPN
        is_tunnel "$ifc" && continue
        { [ "$ifc" = "-" ] && is_tunnel "$primary"; } && continue
      fi
      OFFICE_REASON="📶 Rete Reply"; name_office_from_cache; return 0
    done <<EOF
$(dns_domains)
EOF
  fi
  if at_office_by_location; then
    OFFICE_REASON="📍 Reply $LOC_OFFICE"; return 0
  fi
  return 1
}

# Se la posizione è già nota (cache fresca), il sottotitolo nomina l'ufficio invece della rete
name_office_from_cache() {
  [ -f "$LOCATION_FILE" ] && [ "$(file_age "$LOCATION_FILE")" -lt $(( LOCATION_CACHE_MINUTES * 60 )) ] || return 0
  read_location && [ "$LOC_STATUS" = IN ] && OFFICE_REASON="📍 Reply $LOC_OFFICE"
  return 0
}

in_window() {
  local dow h
  dow="$(date +%u)"
  h="$(date +%H)"; h=$((10#$h))
  case " $WORKDAYS " in *" $dow "*) ;; *) return 1 ;; esac
  [ "$h" -ge "$START_HOUR" ] && [ "$h" -lt "$END_HOUR" ]
}

# ---------------------------------------------------------------- stato
done_file()  { echo "$STATE_DIR/done-$(today)"; }
is_done()    { [ -f "$(done_file)" ]; }
mark_done()  {
  rm -f "$STATE_DIR"/done-* "$STATE_DIR/snooze_until"
  : > "$(done_file)"
  log "check-in segnato come fatto"
}
snooze()     { echo $(( $(now) + ${1:-$SNOOZE_MINUTES} * 60 )) > "$STATE_DIR/snooze_until"; }
is_snoozed() {
  local u
  [ -f "$STATE_DIR/snooze_until" ] || return 1
  u="$(cat "$STATE_DIR/snooze_until" 2>/dev/null)"
  [ "$(now)" -lt "${u:-0}" ]
}

acquire_lock() {
  local l="$STATE_DIR/lock" m
  mkdir "$l" 2>/dev/null && return 0
  m="$(stat -f %m "$l" 2>/dev/null || echo 0)"
  if [ $(( $(now) - m )) -gt 1800 ]; then          # lock orfano (>30 min)
    rmdir "$l" 2>/dev/null; mkdir "$l" 2>/dev/null && return 0
  fi
  return 1
}
release_lock() { rmdir "$STATE_DIR/lock" 2>/dev/null; }

# ---------------------------------------------------------------- aggiornamenti
repo_token() { security find-generic-password -s "$APP_ID" -a token -w 2>/dev/null; }

fetch() {   # fetch <path-nel-repo> <file-destinazione>
  local tok
  tok="$(repo_token)"
  if [ -n "$tok" ]; then
    curl -fsSL --max-time 15 -H "Authorization: token $tok" "$REPO_RAW/$1" -o "$2"
  else
    curl -fsSL --max-time 15 "$REPO_RAW/$1" -o "$2"
  fi
}

# 0 se $1 > $2 (versioni x.y.z)
version_gt() {
  local IFS=. i a b
  read -r -a a <<< "$1"; read -r -a b <<< "$2"
  for i in 0 1 2; do
    [ "${a[i]:-0}" -gt "${b[i]:-0}" ] 2>/dev/null && return 0
    [ "${a[i]:-0}" -lt "${b[i]:-0}" ] 2>/dev/null && return 1
  done
  return 1
}

remote_version() {
  local t
  t="$(mktemp)"
  if fetch VERSION "$t" 2>/dev/null; then tr -d ' \n\r' < "$t"; fi
  rm -f "$t"
}

# Sostituisce solo lo script (atomico: mv su un nuovo inode, sicuro anche mentre gira).
self_update() {
  local rv="$1" t
  t="$(mktemp "$(dirname "$BIN")/.checkin-reminder.XXXXXX")" || return 1
  if fetch bin/checkin-reminder "$t" \
     && bash -n "$t" \
     && grep -q "^VERSION=\"$rv\"" "$t"; then
    chmod 755 "$t"; mv -f "$t" "$BIN"
    update_offices
    log "aggiornato $VERSION → $rv"
    return 0
  fi
  rm -f "$t"; log "aggiornamento a $rv non riuscito"; return 1
}

update_offices() {
  local t
  mkdir -p "$SHARE_DIR"
  t="$(mktemp "$SHARE_DIR/.offices.XXXXXX")" || return 1
  if fetch offices.tsv "$t" && grep -q $'\t' "$t"; then mv -f "$t" "$OFFICES_FILE"; else rm -f "$t"; fi
}

release_asset_url() {   # raw URL di main → URL dell'ultima release
  case "$REPO_RAW" in
    https://raw.githubusercontent.com/*)
      local p="${REPO_RAW#https://raw.githubusercontent.com/}"; p="${p%/main}"
      echo "https://github.com/$p/releases/latest/download/$1" ;;
    https://*/raw/*)
      local host="${REPO_RAW#https://}"; host="${host%%/*}"
      local p="${REPO_RAW#https://$host/raw/}"; p="${p%/main}"
      echo "https://$host/$p/releases/latest/download/$1" ;;
  esac
}

app_version() {
  plutil -extract CFBundleShortVersionString raw "$NOTIFIER_APP/Contents/Info.plist" 2>/dev/null
}

# Se l'app notifiche è più vecchia dello script, scarica quella dell'ultima release.
# Fa rileggere a macOS app e icona (Launch Services + cache icone del Centro notifiche)
refresh_app_registration() {
  touch "$NOTIFIER_APP"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$NOTIFIER_APP" >/dev/null 2>&1
  killall usernoted NotificationCenter >/dev/null 2>&1 || true   # si riavviano da soli
}

open_notification_settings() {
  open "x-apple.systempreferences:com.apple.Notifications-Settings.extension?id=com.reply.checkin-reminder.notifier" 2>/dev/null \
    || open "x-apple.systempreferences:com.apple.preference.notifications"
}

alert_style() { cat "$STATE_DIR/alert_style" 2>/dev/null; }

update_app() {
  local url tmp tok av
  [ -d "$NOTIFIER_APP" ] || return 0              # mai installata (o stile dialog): non la imponiamo
  av="$(app_version)"
  version_gt "$VERSION" "${av:-0}" || return 0
  url="$(release_asset_url CheckinNotifier.zip)"; [ -n "$url" ] || return 1
  tmp="$(mktemp -d)"
  tok="$(repo_token)"
  if { if [ -n "$tok" ]; then curl -fsSL --max-time 60 -H "Authorization: token $tok" "$url" -o "$tmp/n.zip"
       else curl -fsSL --max-time 60 "$url" -o "$tmp/n.zip"; fi; } \
     && ditto -x -k "$tmp/n.zip" "$tmp" && [ -x "$tmp/CheckinNotifier.app/Contents/MacOS/CheckinNotifier" ]; then
    rm -rf "$NOTIFIER_APP" && ditto "$tmp/CheckinNotifier.app" "$NOTIFIER_APP"
    refresh_app_registration
    log "app notifiche aggiornata ${av:-?} → $(app_version)"
    rm -rf "$tmp"; return 0
  fi
  rm -rf "$tmp"; return 1
}

# Primo avvio di una nuova versione dello script: allinea subito app ed elenco uffici
# (senza aspettare il controllo giornaliero). Ritenta al massimo ogni 30 minuti.
sync_components() {
  local sv="$STATE_DIR/script_version" try="$STATE_DIR/last_sync_try"
  [ "$(cat "$sv" 2>/dev/null)" = "$VERSION" ] && return 0
  [ -n "$REPO_RAW" ] || { echo "$VERSION" > "$sv"; return 0; }
  [ -f "$try" ] && [ "$(file_age "$try")" -lt 1800 ] && return 0
  : > "$try"
  [ -f "$OFFICES_FILE" ] || update_offices
  if update_app; then echo "$VERSION" > "$sv"; rm -f "$try"; fi
}

maybe_auto_update() {
  local f="$STATE_DIR/last_update_check" last rv
  [ "$AUTO_UPDATE" = 1 ] && [ -n "$REPO_RAW" ] || return 0
  sync_components
  last="$(cat "$f" 2>/dev/null || echo 0)"
  [ $(( $(now) - last )) -ge $(( UPDATE_CHECK_HOURS * 3600 )) ] || return 0
  rv="$(remote_version)"
  if [ -z "$rv" ]; then          # offline / errore: riprova tra un'ora
    echo $(( $(now) - UPDATE_CHECK_HOURS * 3600 + 3600 )) > "$f"; return 0
  fi
  now > "$f"
  version_gt "$rv" "$VERSION" && self_update "$rv"
  # componenti rimasti indietro (es. dopo un auto-aggiornamento del solo script)
  [ -f "$OFFICES_FILE" ] || update_offices
  update_app || echo $(( $(now) - UPDATE_CHECK_HOURS * 3600 + 3600 )) > "$f"   # release non pronta: riprova tra un'ora
  return 0
}

cmd_update() {
  local rv t
  [ -n "$REPO_RAW" ] || { echo "Sorgente aggiornamenti non configurata: reinstalla dal repo."; return 1; }
  echo "Versione installata: $VERSION"
  rv="$(remote_version)"
  [ -n "$rv" ] || { echo "Impossibile leggere la versione da $REPO_RAW (rete o token?)."; return 1; }
  echo "Ultima versione:     $rv"
  if ! version_gt "$rv" "$VERSION" && [ "${1:-}" != "--force" ]; then
    echo "Sei già aggiornato. (usa 'update --force' per reinstallare)"; return 0
  fi
  # aggiornamento completo: rilancia l'installer (aggiorna anche il LaunchAgent, mantiene la config)
  t="$(mktemp)"
  fetch install.sh "$t" || { rm -f "$t"; echo "Download dell'installer non riuscito."; return 1; }
  CHECKIN_REPO_RAW="$REPO_RAW" bash "$t"; local rc=$?
  rm -f "$t"; return $rc
}

# ---------------------------------------------------------------- testi
# Coppie "titolo|testo". Le prime volte del giorno usa COPY_FIRST, dopo un rinvio COPY_AGAIN.
COPY_FIRST=(
  "Ehm… e il check-in?|Ti vedo: sei in ufficio. Desk Booking invece non lo sa ancora."
  "Alt, controllo presenze 🧐|Risulti in sede ma non su Desk Booking. Dieci secondi e ti lascio in pace."
  "Non fare finta di niente|Sei arrivato in ufficio. Il check-in, invece, non ancora."
  "L'ispettore ha una domanda|«Where are you today?» Io lo so. Desk Booking no."
  "Bentrovato in ufficio ☕|Prima del caffè, un check-in veloce: così i colleghi sanno dove trovarti."
  "Psst… il check-in|Due clic su Desk Booking e l'ispettore torna a sonnecchiare."
)
COPY_AGAIN=(
  "Sono tornato 👀|Avevi detto «tra un attimo». L'attimo è passato."
  "Secondo avviso|L'ispettore non dimentica. Il check-in nemmeno dovrebbe."
  "Ultima chiamata (forse)|Un clic su «Lo faccio ora» e non mi senti più fino a domani."
)

shown_file() { echo "$STATE_DIR/shown-$(today)"; }

# Imposta COPY_TITLE e COPY_BODY. TITLE/MESSAGE nella config, se valorizzati, vincono.
pick_copy() {
  local n pair
  n="$(cat "$(shown_file)" 2>/dev/null || echo 0)"
  if [ "$n" -gt 0 ]; then
    pair="${COPY_AGAIN[$((RANDOM % ${#COPY_AGAIN[@]}))]}"
  else
    pair="${COPY_FIRST[$((RANDOM % ${#COPY_FIRST[@]}))]}"
  fi
  COPY_TITLE="${TITLE:-${pair%%|*}}"
  COPY_BODY="${MESSAGE:-${pair#*|}}"
}

count_shown() {
  local n f cur
  cur="$(shown_file)"
  for f in "$STATE_DIR"/shown-*; do
    [ -e "$f" ] && [ "$f" != "$cur" ] && rm -f "$f"
  done
  n="$(cat "$cur" 2>/dev/null || echo 0)"
  echo $((n + 1)) > "$(shown_file)"
}

# ---------------------------------------------------------------- promemoria
notifier_ok() {
  [ -x "$NOTIFIER_APP/Contents/MacOS/CheckinNotifier" ] || return 1
  ! grep -qs '^denied' "$STATE_DIR/notifier_status"
}

remind() {
  local reason="$1" answer
  pick_copy
  count_shown

  if [ "$REMIND_STYLE" = banner ] && notifier_ok; then
    open -n -g -a "$NOTIFIER_APP" --args post \
      --title "$COPY_TITLE" --subtitle "$reason" --body "$COPY_BODY" \
      --url "$CHECKIN_URL" --snooze "$SNOOZE_MINUTES" --cli "$BIN"
    # in attesa di risposta: non ripresentarla prima di SNOOZE_MINUTES
    snooze "$SNOOZE_MINUTES"
    log "notifica inviata ($reason)"
    return
  fi

  answer="$(osascript - "$COPY_TITLE" "$COPY_BODY" "$reason" "$CHECKIN_URL" "$SNOOZE_MINUTES" 2>/dev/null <<'APPLESCRIPT'
on run argv
  set theTitle to item 1 of argv
  set theMsg to item 2 of argv
  set theReason to item 3 of argv
  set theUrl to item 4 of argv
  set snoozeLabel to "Tra " & (item 5 of argv) & " min"
  if theUrl is "" then
    set btns to {snoozeLabel, "Già fatto"}
    set defBtn to "Già fatto"
  else
    set btns to {snoozeLabel, "Già fatto", "Lo faccio ora"}
    set defBtn to "Lo faccio ora"
  end if
  activate
  try
    set res to display dialog (theTitle & return & return & theMsg & return & return & theReason) with title "Check-in" buttons btns default button defBtn with icon note giving up after 600
    if gave up of res then return "timeout"
    return button returned of res
  on error
    return "cancel"
  end try
end run
APPLESCRIPT
)"

  case "$answer" in
    "Già fatto")     mark_done ;;
    "Lo faccio ora") open "$CHECKIN_URL"; mark_done ;;
    *)               snooze "$SNOOZE_MINUTES"; log "rimandato di $SNOOZE_MINUTES min ($answer)" ;;
  esac
}

# ---------------------------------------------------------------- comandi
cmd_check() {
  maybe_auto_update
  in_window  || return 0
  is_done    && return 0
  is_snoozed && return 0
  at_office  || return 0
  acquire_lock || return 0
  trap release_lock EXIT
  log "in ufficio ($OFFICE_REASON): mostro il promemoria"
  remind "$OFFICE_REASON"
}

cmd_test() {
  acquire_lock || { echo "Un promemoria è già aperto."; return 1; }
  trap release_lock EXIT
  at_office || OFFICE_REASON="🧪 Prova"
  remind "$OFFICE_REASON"
}

yn() { if "$@"; then echo "sì"; else echo "no"; fi; }

describe_location() {
  case "$LOC_STATUS" in
    IN)        echo "in ufficio: Reply $LOC_OFFICE (${LOC_DIST} m, precisione ±${LOC_ACC} m)" ;;
    OUT)       echo "fuori ufficio — il più vicino è Reply $LOC_OFFICE a ${LOC_DIST} m" ;;
    DENIED)    echo "permesso negato (Impostazioni di Sistema → Privacy e sicurezza → Localizzazione → Check-in)" ;;
    DISABLED)  echo "Localizzazione disattivata nel Mac" ;;
    TIMEOUT)   echo "nessuna risposta (riprova; serve il Wi-Fi acceso)" ;;
    NOOFFICES) echo "elenco uffici mancante (checkin-reminder update --force)" ;;
    *)         echo "${LOC_STATUS:-sconosciuta}" ;;
  esac
}

cmd_where() {
  location_available || { echo "Posizione non disponibile (LOCATION_CHECK=0 o app notifiche mancante)."; return 1; }
  echo "Leggo la posizione…"
  refresh_location force
  read_location
  echo "Posizione: $(describe_location)"
}

cmd_status() {
  local ifc a b c ssid office
  ifc="$(wifi_iface)"
  a="$(ssid_from_ipconfig "$ifc")"
  b="$(ssid_from_networksetup "$ifc")"
  c="$(ssid_from_profiler)"
  ssid="$(current_ssid)"
  if at_office; then office="sì"; else office="no"; fi

  echo "checkin-reminder $VERSION"
  echo
  echo "Config:            $CONFIG_FILE $([ -f "$CONFIG_FILE" ] || echo '(non trovato, uso i default)')"
  echo "Pattern Wi-Fi:     ${SSID_PATTERN:-<disattivato>}"
  echo "Pattern DNS:       ${DNS_DOMAIN_PATTERN:-<disattivato>}  (VPN conta come ufficio: $([ "$VPN_COUNTS_AS_OFFICE" = 1 ] && echo sì || echo no))"
  echo "URL check-in:      ${CHECKIN_URL:-<non impostato>}"
  if [ "$REMIND_STYLE" = banner ]; then
    if notifier_ok; then
      echo "Promemoria:        notifica (permesso: $(cat "$STATE_DIR/notifier_status" 2>/dev/null || echo 'non ancora chiesto'), stile: $(alert_style || echo '?'))"
      [ "$(alert_style)" = banner ] && echo "                   ⚠️  stile Banner: sparisce da sola. Per tenerla a schermo: checkin-reminder notifiche → Avvisi"
    elif [ -x "$NOTIFIER_APP/Contents/MacOS/CheckinNotifier" ]; then echo "Promemoria:        finestra (notifiche NEGATE: Impostazioni di Sistema → Notifiche → Check-in)"
    else echo "Promemoria:        finestra (app notifiche non installata)"; fi
  else
    echo "Promemoria:        finestra"
  fi
  echo "Aggiornamenti:     ${REPO_RAW:-<non configurati>} (auto: $([ "$AUTO_UPDATE" = 1 ] && echo sì || echo no))"
  echo
  echo "Interfaccia Wi-Fi: $ifc"
  echo "  ipconfig:        ${a:-—}"
  echo "  networksetup:    ${b:-—}"
  echo "  system_profiler: ${c:-—}"
  echo "SSID usato:        ${ssid:-<nessuno / non leggibile>}"
  echo "Interfaccia default: $(default_iface)"
  echo "Domini DNS (dominio interfaccia):"
  dns_domains | grep -v 'arpa ' | sed 's/^/  /'
  echo
  if location_available; then
    read_location && echo "Posizione:         $(describe_location) [$(( $(file_age "$LOCATION_FILE") / 60 )) min fa]" \
      || echo "Posizione:         non ancora letta (prova: checkin-reminder where)"
  else
    echo "Posizione:         non usata"
  fi
  echo "In ufficio adesso: $office ${OFFICE_REASON:+($OFFICE_REASON)}"
  echo "Orario lavorativo: $(yn in_window)"
  echo "Check-in fatto:    $(yn is_done)"
  echo "Rimandato:         $(yn is_snoozed)"
  if launchctl print "gui/$(id -u)/$APP_ID" >/dev/null 2>&1; then
    echo "Servizio:          attivo"
  else
    echo "Servizio:          NON attivo (rilancia l'installer)"
  fi

  if [ "$a" = "<redacted>" ] && ! valid_ssid "$ssid" && [ -z "$DNS_DOMAIN_PATTERN" ]; then
    echo
    echo "⚠️  macOS nasconde il nome della Wi-Fi e il rilevamento DNS è spento."
    echo "    Imposta DNS_DOMAIN_PATTERN (checkin-reminder config) oppure: sudo ipconfig setverbose 1"
  fi
}

cmd_uninstall() {
  launchctl bootout "gui/$(id -u)/$APP_ID" 2>/dev/null \
    || launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  rm -rf "$STATE_DIR"
  rm -f "$LOG_FILE" "$HOME/Library/Logs/checkin-reminder.err.log"
  security delete-generic-password -s "$APP_ID" -a token >/dev/null 2>&1 || true
  if [ "${1:-}" = "--purge" ]; then rm -rf "$CONFIG_DIR"; fi
  rm -rf "$NOTIFIER_APP" "$SHARE_DIR"
  rm -f "$BIN"
  echo "checkin-reminder disinstallato."
  [ "${1:-}" = "--purge" ] || echo "(La config resta in $CONFIG_DIR — usa 'uninstall --purge' per rimuoverla.)"
}

cmd_help() {
  cat <<EOF
checkin-reminder $VERSION — promemoria check-in quando sei in ufficio

Comandi:
  status          mostra cosa rileva (Wi-Fi, DNS, posizione, orario, stato) — utile per diagnosi
  where           legge ora la posizione e dice in quale ufficio sei
  notifiche       apre le impostazioni notifiche (stile "Avvisi" = resta a schermo)
  test            mostra subito il promemoria
  done            segna il check-in di oggi come fatto
  snooze [min]    rimanda il promemoria
  reset           azzera lo stato di oggi (fatto / rimandato)
  config          apre il file di configurazione
  log             mostra le ultime righe del log
  update          aggiorna all'ultima versione (--force per reinstallare)
  uninstall       disinstalla (aggiungi --purge per rimuovere anche la config)
  version         versione
  check           (usato dal servizio) controlla e, se serve, mostra il promemoria
EOF
}

case "${1:-check}" in
  check)            cmd_check ;;
  status|doctor)    cmd_status ;;
  where)            cmd_where ;;
  notifiche|notifications)
                    open_notification_settings
                    echo "Scegli lo stile «Avvisi»: la notifica resta a schermo finché non scegli un'azione." ;;
  test)             cmd_test ;;
  done)             mark_done; echo "Ok, check-in di oggi segnato come fatto." ;;
  snooze)           snooze "${2:-$SNOOZE_MINUTES}"; log "rimandato di ${2:-$SNOOZE_MINUTES} min"; echo "Ok, te lo ricordo tra ${2:-$SNOOZE_MINUTES} minuti." ;;
  reset)            rm -f "$STATE_DIR"/done-* "$STATE_DIR"/shown-* "$STATE_DIR/snooze_until" "$STATE_DIR/location"; echo "Stato di oggi azzerato." ;;
  config)           mkdir -p "$CONFIG_DIR"; [ -f "$CONFIG_FILE" ] || : > "$CONFIG_FILE"; open -t "$CONFIG_FILE" ;;
  log)              tail -n 30 "$LOG_FILE" 2>/dev/null || echo "Log vuoto." ;;
  update|upgrade)   cmd_update "${2:-}" ;;
  uninstall)        cmd_uninstall "${2:-}" ;;
  version|-v|--version) echo "$VERSION" ;;
  help|-h|--help)   cmd_help ;;
  *)                cmd_help; exit 1 ;;
esac
